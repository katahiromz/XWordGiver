; AIModels.dat --- XWordGiver AI ヘルパーの AI モデル データ。
; AIModels.dat --- The AI model data for XWordGiver AI Helper.
;
; このファイルは自己責任で自由に編集しても構いません。
; You are free to edit this file at your own risk.
;
; 【文法】 / [Syntax]
;   - ';' から始まる行はコメントです。 / Lines starting with ';' are comments.
;   - '[セクション名]' で区画（セクション）を区切ります。 / '[SectionName]' starts a new section.
;   - 各セクションの中身は「1行1項目」または「キー=値」です。 / Each section holds one item per line, or key=value(s) pairs.
;   - 空行は無視されます。 / Blank lines are ignored.
;   - このファイルは UTF-8 (BOM付き) で保存してください。 / Save this file as UTF-8 with BOM.
;   - 値はカンマ区切りです。 / Value(s) are comma-separated.
;
; このファイルは AIModelsDat.cpp / AIHelper.py / AIHelper_ja.py から
; 共通して読み込まれます。実行ファイル（またはスクリプト）と同じフォルダに置いてください。
; This file is shared by AIModelsDat.cpp / AIHelper.py / AIHelper_ja.py.
; Place it in the same folder as the executable (or the scripts).

[PROVIDER_INFO]
; プロバイダー接続設定。
; Provider connection settings.
;
; 書式: プロバイダー = APIキー環境変数名, ホスト名, ポート, パス, OpenAI互換か, Claude形式か, Gemini形式か, HTTPSか
;       (フラグは 0 か 1)
; Format: provider = api_key_env, host, port, path, isOpenAICompat, isClaude, isGemini, useHttps
;         (flags are 0 or 1)
openai      = OPENAI_API_KEY,       api.openai.com, 443, /v1/chat/completions, 1, 0, 0, 1
google      = GOOGLE_API_KEY,       generativelanguage.googleapis.com, 443, , 0, 0, 1, 1
anthropic   = ANTHROPIC_API_KEY,    api.anthropic.com, 443, /v1/messages, 0, 1, 0, 1
xai         = XAI_API_KEY,          api.x.ai, 443, /v1/chat/completions, 1, 0, 0, 1
deepseek    = DEEPSEEK_API_KEY,     api.deepseek.com, 443, /v1/chat/completions, 1, 0, 0, 1
sakana      = SAKANA_API_KEY,       api.sakana.ai, 443, /v1/chat/completions, 1, 0, 0, 1
dashscope   = DASHSCOPE_API_KEY,    dashscope-intl.aliyuncs.com, 443, /compatible-mode/v1/chat/completions, 1, 0, 0, 1
moonshot    = MOONSHOT_API_KEY,     api.moonshot.ai, 443, /v1/chat/completions, 1, 0, 0, 1
mistral     = MISTRAL_API_KEY,      api.mistral.ai, 443, /v1/chat/completions, 1, 0, 0, 1
llama       = LLAMA_API_KEY,        api.llama.com, 443, /compat/v1/chat/completions, 1, 0, 0, 1
minimax     = MINIMAX_API_KEY,      api.minimax.io, 443, /v1/chat/completions, 1, 0, 0, 1
zai         = ZAI_API_KEY,          api.z.ai, 443, /api/paas/v4/chat/completions, 1, 0, 0, 1
pepabo      = AI_GATEWAY_API_KEY,   ai-gateway.lolipop.jp, 443, /v1/chat/completions, 1, 0, 0, 1
; ローカルAI（Ollama）。APIキー不要。
; Local AI (Ollama). No API key is required.
ollama      = ,                     localhost, 11434, /v1/chat/completions, 1, 0, 0, 0

; ----------------------------------------------------------------------------
; 既知のAIモデル名一覧（プロバイダーごと）。各セクションの先頭のモデルが、そのプロバイダーの
; 既定モデルとして使われる。
; Known AI model names, per provider. The first model listed in each section is
; used as that provider's default model.
; TODO: １ヵ月ごとに以下の既知のAIモデル名一覧を更新せよ。先頭は無料モデルにしておくこと
;       （先頭モデルは既定モデルにもなるため）。
; TODO: Update the list below about once a month. Keep a free model first
;       (the first entry also becomes the default model).
; 更新日 / Last updated: 2026-09-22
; ----------------------------------------------------------------------------

